From: Mauro Ribeiro <mdrjr0@gmail.com>
Subject: [PATCH] rtl8821au: shut up gcc 15 header-guard whining

---
 drivers/net/wireless/rtl8821au/Makefile | 1 +
 1 file changed, 1 insertion(+)

--- a/drivers/net/wireless/rtl8821au/Makefile
+++ b/drivers/net/wireless/rtl8821au/Makefile
@@ -18,6 +18,7 @@ EXTRA_CFLAGS += -Wno-unused-variable
 #EXTRA_CFLAGS += -Wno-vla
 #EXTRA_CFLAGS += -Wno-misleading-indentation
 EXTRA_CFLAGS += -Wno-implicit-fallthrough
+EXTRA_CFLAGS += $(call cc-option,-Wno-header-guard)
 #EXTRA_CFLAGS += -Wno-return-type
 #EXTRA_CFLAGS += -Wno-discarded-qualifiers
 
